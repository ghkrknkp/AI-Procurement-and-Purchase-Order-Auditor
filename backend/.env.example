# AI Procurement Auditor Configuration
PROJECT_NAME="AI Procurement and Purchase Order Auditor"
ENVIRONMENT="development"
DEBUG=True

# Security
SECRET_KEY="change-me-to-a-super-secret-random-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="sqlite:///./procurement.db"

# File Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10

# OCR Settings
TESSERACT_CMD="" # e.g. "C:\\Program Files\\Tesseract-OCR\\tesseract.exe" or leave empty to auto-detect

# Tolerance Settings
ROUNDING_TOLERANCE=0.05
